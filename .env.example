# Environment Variables Template for next-building

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database (PostgreSQL / Neon)
DATABASE_URL=postgresql://user:password@localhost:5432/next_building
DATABASE_URL_UNPOOLED=postgresql://user:password@localhost:5432/next_building

# Authentication & Session (WorkOS / Custom Auth)
WORKOS_CLIENT_ID=
WORKOS_API_KEY=
WORKOS_COOKIE_PASSWORD=
NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://localhost:3000/callback

# Storage (Vercel Blob / S3)
BLOB_READ_WRITE_TOKEN=
BLOB_STORE_ID=

# External Services & APIs
GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_API_KEY=
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=
NEXT_PUBLIC_MAPBOX_STYLE_URL=

# Background Workers & Queues (Upstash QStash)
QSTASH_TOKEN=
QSTASH_BASE_URL=https://qstash.upstash.io

# Governance, Project & Linear Integration
DEFAULT_OWNER=dev
DEFAULT_ISSUE_PREFIX=TASK
LINEAR_ENABLED=false
LINEAR_API_KEY=

